#[derive(Clone)]
pub struct IslamicKnowledgeRepository {
    pool: PgPool,
}

impl IslamicKnowledgeRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }

    pub async fn list_sources(
        &self,
        language: Option<&str>,
        source_type: Option<&str>,
    ) -> Result<Vec<IslamicSource>, ApiError> {
        let rows = sqlx::query(
            r#"
            SELECT id, source_key, source_name, source_type, language, base_url, license_name
            FROM sakina_ai.islamic_sources
            WHERE is_active = true
              AND ($1::text IS NULL OR language = $1)
              AND ($2::text IS NULL OR source_type = $2)
            ORDER BY source_name ASC
            "#,
        )
        .bind(language)
        .bind(source_type)
        .fetch_all(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to list islamic sources"))?;

        Ok(rows
            .into_iter()
            .map(|row| IslamicSource {
                id: row.get("id"),
                source_key: row.get("source_key"),
                source_name: row.get("source_name"),
                source_type: row.get("source_type"),
                language: row.get("language"),
                base_url: row.get("base_url"),
                license_name: row.get("license_name"),
            })
            .collect())
    }

    pub async fn list_documents(
        &self,
        language: Option<&str>,
        source_filter: Option<&str>,
    ) -> Result<Vec<IslamicDocument>, ApiError> {
        let rows = sqlx::query(
            r#"
            SELECT d.id, d.source_id, d.document_key, d.title, d.language, d.source_url, d.source_type
            FROM sakina_ai.islamic_documents d
            JOIN sakina_ai.islamic_sources s ON s.id = d.source_id
            WHERE ($1::text IS NULL OR d.language = $1)
              AND ($2::text IS NULL OR s.source_key = $2 OR s.source_type = $2)
            ORDER BY d.created_at DESC
            LIMIT 200
            "#,
        )
        .bind(language)
        .bind(source_filter)
        .fetch_all(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to list islamic documents"))?;

        Ok(rows
            .into_iter()
            .map(|row| IslamicDocument {
                id: row.get("id"),
                source_id: row.get("source_id"),
                document_key: row.get("document_key"),
                title: row.get("title"),
                language: row.get("language"),
                source_url: row.get("source_url"),
                source_type: row.get("source_type"),
            })
            .collect())
    }

    pub async fn list_chunks(&self, document_id: Uuid) -> Result<Vec<IslamicChunk>, ApiError> {
        let rows = sqlx::query(
            r#"
            SELECT id, document_id, chunk_key, chunk_index, chunk_text, language, source_type, citation_label
            FROM sakina_ai.islamic_text_chunks
            WHERE document_id = $1
            ORDER BY chunk_index ASC
            "#,
        )
        .bind(document_id)
        .fetch_all(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to list document chunks"))?;

        Ok(rows
            .into_iter()
            .map(|row| IslamicChunk {
                id: row.get("id"),
                document_id: row.get("document_id"),
                chunk_key: row.get("chunk_key"),
                chunk_index: row.get("chunk_index"),
                chunk_text: row.get("chunk_text"),
                language: row.get("language"),
                source_type: row.get("source_type"),
                citation_label: row.get("citation_label"),
            })
            .collect())
    }

    pub async fn search_local_chunks(
        &self,
        query: &str,
        language: &str,
        source_filter: Option<&str>,
        limit: i64,
    ) -> Result<Vec<IslamicSearchHit>, ApiError> {
        let rows = sqlx::query(
            r#"
            SELECT
                c.id AS chunk_id,
                d.id AS document_id,
                s.id AS source_id,
                s.source_name,
                d.title AS document_title,
                c.chunk_text,
                c.citation_label,
                c.language,
                c.source_type
            FROM sakina_ai.islamic_text_chunks c
            JOIN sakina_ai.islamic_documents d ON d.id = c.document_id
            JOIN sakina_ai.islamic_sources s ON s.id = d.source_id
            WHERE c.language = $1
              AND c.chunk_text ILIKE ('%' || $2 || '%')
              AND ($3::text IS NULL OR s.source_key = $3 OR s.source_type = $3)
            ORDER BY c.updated_at DESC
            LIMIT $4
            "#,
        )
        .bind(language)
        .bind(query)
        .bind(source_filter)
        .bind(limit)
        .fetch_all(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to search local islamic data"))?;

        Ok(rows
            .into_iter()
            .map(|row| IslamicSearchHit {
                chunk_id: row.get("chunk_id"),
                document_id: row.get("document_id"),
                source_id: row.get("source_id"),
                source_name: row.get("source_name"),
                document_title: row.get("document_title"),
                chunk_text: row.get("chunk_text"),
                citation_label: row.get("citation_label"),
                language: row.get("language"),
                source_type: row.get("source_type"),
            })
            .collect())
    }

    pub async fn get_citation(
        &self,
        citation_id: Uuid,
    ) -> Result<Option<IslamicCitation>, ApiError> {
        let row = sqlx::query(
            r#"
            SELECT
                c.id,
                c.citation_key,
                c.citation_text,
                c.citation_url,
                s.source_name,
                d.title AS document_title,
                c.language
            FROM sakina_ai.islamic_citations c
            JOIN sakina_ai.islamic_sources s ON s.id = c.source_id
            LEFT JOIN sakina_ai.islamic_documents d ON d.id = c.document_id
            WHERE c.id = $1
            "#,
        )
        .bind(citation_id)
        .fetch_optional(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to load citation"))?;

        Ok(row.map(|row| IslamicCitation {
            id: row.get("id"),
            citation_key: row.get("citation_key"),
            citation_text: row.get("citation_text"),
            citation_url: row.get("citation_url"),
            source_name: row.get("source_name"),
            document_title: row.get("document_title"),
            language: row.get("language"),
        }))
    }

    pub async fn upsert_hadith_document(
        &self,
        collection: &str,
        hadith_id: &str,
        title: &str,
        text: &str,
        language: &str,
    ) -> Result<(Uuid, Uuid), ApiError> {
        let source_key = format!("hadith_api:{collection}");
        let source_name = format!("Hadith API ({collection})");
        let source_id: Uuid = sqlx::query_scalar(
            r#"
            INSERT INTO sakina_ai.islamic_sources (
                source_key, source_name, source_type, language, base_url, robots_policy, license_name, rate_limit_notes
            )
            VALUES ($1, $2, 'hadith', $3, 'https://api.hadith.gading.dev', 'respect-robots', 'API terms', '<=100/hr')
            ON CONFLICT (source_key)
            DO UPDATE SET
                source_name = EXCLUDED.source_name,
                language = EXCLUDED.language,
                updated_at = now()
            RETURNING id
            "#,
        )
        .bind(source_key)
        .bind(source_name)
        .bind(language)
        .fetch_one(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to upsert hadith source"))?;

        let document_key = format!("hadith:{collection}:{hadith_id}");
        let document_id: Uuid = sqlx::query_scalar(
            r#"
            INSERT INTO sakina_ai.islamic_documents (
                source_id, document_key, source_document_id, title, language, source_url, source_type, source_license
            )
            VALUES ($1, $2, $3, $4, $5, NULL, 'hadith', 'API terms')
            ON CONFLICT (document_key)
            DO UPDATE SET
                title = EXCLUDED.title,
                language = EXCLUDED.language,
                updated_at = now()
            RETURNING id
            "#,
        )
        .bind(source_id)
        .bind(document_key)
        .bind(hadith_id)
        .bind(title)
        .bind(language)
        .fetch_one(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to upsert hadith document"))?;

        let chunk_hash = stable_hash(text);
        let chunk_key = format!("hadith:{collection}:{hadith_id}:0");
        let chunk_id: Uuid = sqlx::query_scalar(
            r#"
            INSERT INTO sakina_ai.islamic_text_chunks (
                document_id, chunk_key, chunk_index, chunk_text, language, source_type, citation_label, qdrant_collection, token_count, chunk_hash
            )
            VALUES ($1, $2, 0, $3, $4, 'hadith', $5, 'sakina_hadith_chunks', $6, $7)
            ON CONFLICT (chunk_key)
            DO UPDATE SET
                chunk_text = EXCLUDED.chunk_text,
                language = EXCLUDED.language,
                token_count = EXCLUDED.token_count,
                updated_at = now()
            RETURNING id
            "#,
        )
        .bind(document_id)
        .bind(chunk_key)
        .bind(text)
        .bind(language)
        .bind(format!("{collection} #{hadith_id}"))
        .bind(text.split_whitespace().count() as i32)
        .bind(chunk_hash)
        .fetch_one(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to upsert hadith chunk"))?;

        self.enqueue_embedding(chunk_id, "sakina_hadith_chunks")
            .await?;
        Ok((document_id, chunk_id))
    }

    pub async fn enqueue_embedding(
        &self,
        text_chunk_id: Uuid,
        collection: &str,
    ) -> Result<(), ApiError> {
        sqlx::query(
            r#"
            INSERT INTO sakina_ai.islamic_embeddings_queue (text_chunk_id, qdrant_collection, queue_status)
            VALUES ($1, $2, 'pending')
            ON CONFLICT (text_chunk_id, qdrant_collection)
            DO UPDATE SET
                queue_status = 'pending',
                updated_at = now()
            "#,
        )
        .bind(text_chunk_id)
        .bind(collection)
        .execute(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to enqueue embedding"))?;
        Ok(())
    }

    pub async fn create_or_get_citation_from_hit(
        &self,
        hit: &IslamicSearchHit,
    ) -> Result<IslamicCitation, ApiError> {
        let citation_key = format!("chunk:{}", hit.chunk_id);
        let citation_text = if hit.citation_label.trim().is_empty() {
            format!("{} — {}", hit.source_name, hit.document_title)
        } else {
            hit.citation_label.clone()
        };

        let citation_id: Uuid = sqlx::query_scalar(
            r#"
            INSERT INTO sakina_ai.islamic_citations (
                source_id, document_id, text_chunk_id, citation_key, citation_text, language
            )
            VALUES ($1, $2, $3, $4, $5, $6)
            ON CONFLICT (citation_key)
            DO UPDATE SET
                citation_text = EXCLUDED.citation_text,
                language = EXCLUDED.language
            RETURNING id
            "#,
        )
        .bind(hit.source_id)
        .bind(hit.document_id)
        .bind(hit.chunk_id)
        .bind(citation_key.clone())
        .bind(citation_text.clone())
        .bind(hit.language.clone())
        .fetch_one(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to upsert citation"))?;

        Ok(IslamicCitation {
            id: citation_id,
            citation_key,
            citation_text,
            citation_url: None,
            source_name: hit.source_name.clone(),
            document_title: Some(hit.document_title.clone()),
            language: hit.language.clone(),
        })
    }

    pub async fn log_question_answer(
        &self,
        input: LogQuestionAnswerInput<'_>,
    ) -> Result<(), ApiError> {
        let qa_id: Uuid = sqlx::query_scalar(
            r#"
            INSERT INTO sakina_ai.islamic_question_answers (
                question_text, answer_text, language, answer_mode, has_evidence, fallback_used, fatwa_sensitive
            )
            VALUES ($1, $2, $3, 'evidence_only', $4, $5, $6)
            RETURNING id
            "#,
        )
        .bind(input.question)
        .bind(input.answer)
        .bind(input.language)
        .bind(input.has_evidence)
        .bind(input.fallback_used)
        .bind(input.fatwa_sensitive)
        .fetch_one(&self.pool)
        .await
        .map_err(|_| ApiError::internal("failed to log islamic answer"))?;

        for citation in input.citations {
            sqlx::query(
                r#"
                INSERT INTO sakina_ai.islamic_answer_citations (
                    question_answer_id, citation_id, evidence_snippet
                )
                VALUES ($1, $2, $3)
                "#,
            )
            .bind(qa_id)
            .bind(citation.id)
            .bind(citation.citation_text.clone())
            .execute(&self.pool)
            .await
            .map_err(|_| ApiError::internal("failed to link islamic answer citation"))?;
        }
        Ok(())
    }
}

#[derive(Clone)]
pub struct IslamicAnswerService {
    repo: IslamicKnowledgeRepository,
    qdrant: QdrantVectorDB,
    embeddings: EmbeddingsService,
}

impl IslamicAnswerService {
    pub fn new(
        repo: IslamicKnowledgeRepository,
        qdrant: QdrantVectorDB,
        embeddings: EmbeddingsService,
    ) -> Self {
        Self {
            repo,
            qdrant,
            embeddings,
        }
    }

    pub async fn answer(&self, req: AskIslamicRequest) -> Result<AskIslamicResponse, ApiError> {
        let language = req
            .language
            .as_deref()
            .filter(|value| matches!(*value, "ar" | "en"))
            .map(ToOwned::to_owned)
            .unwrap_or_else(|| detect_language_ar_en(&req.question).to_string());
        let fatwa_sensitive = is_fatwa_sensitive(&req.question);

        let local_hits = self
            .repo
            .search_local_chunks(&req.question, &language, req.source.as_deref(), 5)
            .await?;
        if !local_hits.is_empty() {
            let mut citations = Vec::with_capacity(local_hits.len());
            for hit in &local_hits {
                citations.push(self.repo.create_or_get_citation_from_hit(hit).await?);
            }

            let answer = render_evidence_answer(&local_hits, &language, fatwa_sensitive);
            self.repo
                .log_question_answer(LogQuestionAnswerInput {
                    question: &req.question,
                    answer: &answer,
                    language: &language,
                    has_evidence: true,
                    fallback_used: false,
                    fatwa_sensitive,
                    citations: &citations,
                })
                .await?;
            return Ok(AskIslamicResponse {
                language,
                answer,
                fallback_used: false,
                fatwa_sensitive,
                citations,
            });
        }

        let mut citations = Vec::new();
        let embedding = self
            .embeddings
            .embed(&req.question)
            .await
            .map_err(|_| ApiError::service_unavailable("embedding service unavailable"))?;
        let qdrant_hits = self
            .qdrant
            .search(&embedding, 0.82, 4)
            .await
            .map_err(|_| ApiError::service_unavailable("qdrant search unavailable"))?;

        for hit in qdrant_hits {
            if let Some(payload) = hit.payload {
                let citation_text = payload
                    .get("citation_text")
                    .and_then(|v| v.as_str())
                    .unwrap_or("")
                    .trim()
                    .to_string();
                if citation_text.is_empty() {
                    continue;
                }
                let source_name = payload
                    .get("source_name")
                    .and_then(|v| v.as_str())
                    .unwrap_or("Verified source")
                    .to_string();
                citations.push(IslamicCitation {
                    id: Uuid::new_v4(),
                    citation_key: payload
                        .get("citation_key")
                        .and_then(|v| v.as_str())
                        .unwrap_or("qdrant-evidence")
                        .to_string(),
                    citation_text,
                    citation_url: payload
                        .get("citation_url")
                        .and_then(|v| v.as_str())
                        .map(ToOwned::to_owned),
                    source_name,
                    document_title: payload
                        .get("document_title")
                        .and_then(|v| v.as_str())
                        .map(ToOwned::to_owned),
                    language: language.clone(),
                });
            }
        }

        if !citations.is_empty() {
            let answer = if language == "ar" {
                "تم العثور على أدلة من الفهرس المتجهي. يرجى مراجعة الاقتباسات المرفقة فقط."
                    .to_string()
            } else {
                "Evidence was found from the vector index. Please rely on the attached citations only."
                    .to_string()
            };
            self.repo
                .log_question_answer(LogQuestionAnswerInput {
                    question: &req.question,
                    answer: &answer,
                    language: &language,
                    has_evidence: true,
                    fallback_used: false,
                    fatwa_sensitive,
                    citations: &citations,
                })
                .await?;
            return Ok(AskIslamicResponse {
                language,
                answer,
                fallback_used: false,
                fatwa_sensitive,
                citations,
            });
        }

        let answer = no_evidence_fallback(&language, fatwa_sensitive);
        self.repo
            .log_question_answer(LogQuestionAnswerInput {
                question: &req.question,
                answer: &answer,
                language: &language,
                has_evidence: false,
                fallback_used: true,
                fatwa_sensitive,
                citations: &[],
            })
            .await?;
        Ok(AskIslamicResponse {
            language,
            answer,
            fallback_used: true,
            fatwa_sensitive,
            citations: vec![],
        })
    }
}

pub async fn ensure_phase20_qdrant_collections(
    base_url: &str,
    vector_size: usize,
) -> Result<Vec<String>, ApiError> {
    let mut created = Vec::new();
    for collection in QDRANT_COLLECTIONS {
        let qdrant = QdrantVectorDB::new(base_url, collection);
        let was_created = qdrant
            .ensure_collection_if_missing(vector_size)
            .await
            .map_err(|_| ApiError::service_unavailable("failed to ensure qdrant collection"))?;
        if was_created {
            created.push(collection.to_string());
        }
    }
    Ok(created)
}

#[derive(Debug, Clone, Deserialize)]
pub struct HadithApiItem {
    pub id: String,
    pub text: String,
    pub chapter: Option<String>,
}

#[derive(Debug, Clone, Deserialize)]
pub struct HadithApiResponse {
    pub data: Vec<HadithApiItem>,
    pub next_page: Option<u32>,
}

pub fn parse_hadith_response(body: &str) -> Result<HadithApiResponse, ApiError> {
    serde_json::from_str(body).map_err(|_| ApiError::bad_request("invalid hadith api response"))
}

pub struct HourlyRateLimiter {
    max_per_hour: u32,
    window_start: Instant,
    calls: u32,
}

impl HourlyRateLimiter {
    pub fn new(max_per_hour: u32) -> Self {
        Self {
            max_per_hour,
            window_start: Instant::now(),
            calls: 0,
        }
    }

    pub fn required_wait(&mut self) -> Duration {
        let elapsed = self.window_start.elapsed();
        if elapsed >= Duration::from_secs(3600) {
            self.window_start = Instant::now();
            self.calls = 0;
            return Duration::from_secs(0);
        }
        if self.calls < self.max_per_hour {
            self.calls += 1;
            return Duration::from_secs(0);
        }
        Duration::from_secs(3600).saturating_sub(elapsed)
    }
}

pub struct HadithIngestionWorker {
    repo: IslamicKnowledgeRepository,
    client: Client,
    base_url: String,
    rate_limiter: HourlyRateLimiter,
}

impl HadithIngestionWorker {
    pub fn new(repo: IslamicKnowledgeRepository) -> Self {
        Self {
            repo,
            client: Client::new(),
            base_url: std::env::var("HADITH_API_BASE_URL")
                .unwrap_or_else(|_| "https://api.hadith.gading.dev/books".to_string()),
            rate_limiter: HourlyRateLimiter::new(100),
        }
    }

    pub async fn ingest_collections(&mut self, collections: &[&str]) -> Result<usize, ApiError> {
        let mut total = 0usize;
        for collection in collections {
            total += self.ingest_collection(collection).await?;
        }
        Ok(total)
    }

    async fn ingest_collection(&mut self, collection: &str) -> Result<usize, ApiError> {
        let mut written = 0usize;
        let mut page: u32 = 1;
        loop {
            let wait = self.rate_limiter.required_wait();
            if !wait.is_zero() {
                sleep(wait).await;
            }
            let url = format!("{}/{collection}?page={page}&limit=20", self.base_url);
            let response = self
                .client
                .get(&url)
                .send()
                .await
                .map_err(|_| ApiError::service_unavailable("hadith api unavailable"))?;
            if !response.status().is_success() {
                return Err(ApiError::service_unavailable("hadith api call failed"));
            }
            let text = response
                .text()
                .await
                .map_err(|_| ApiError::service_unavailable("hadith api body read failed"))?;
            let parsed = parse_hadith_response(&text)?;
            for item in parsed.data {
                let title = item
                    .chapter
                    .as_deref()
                    .filter(|value| !value.trim().is_empty())
                    .unwrap_or("Hadith");
                self.repo
                    .upsert_hadith_document(collection, &item.id, title, &item.text, "ar")
                    .await?;
                written += 1;
            }
            match parsed.next_page {
                Some(next) => page = next,
                None => break,
            }
        }
        Ok(written)
    }
}

pub struct UmmahApiIngestionScaffold;
pub struct IslamHouseIngestionScaffold;
pub struct IslamContentIngestionScaffold;
pub struct KalamullahIngestionScaffold;

impl UmmahApiIngestionScaffold {
