        })
    }
}

pub fn detect_language_ar_en(text: &str) -> &'static str {
    let arabic_chars = text
        .chars()
        .filter(|ch| ('\u{0600}'..='\u{06FF}').contains(ch))
        .count();
    let latin_chars = text.chars().filter(|ch| ch.is_ascii_alphabetic()).count();
    if arabic_chars >= latin_chars {
        "ar"
    } else {
        "en"
    }
}

pub fn is_fatwa_sensitive(question: &str) -> bool {
    let q = question.to_lowercase();
    [
        "fatwa", "halal", "haram", "ruling", "فتوى", "حكم", "حلال", "حرام",
    ]
    .iter()
    .any(|needle| q.contains(needle))
}

pub fn no_evidence_fallback(language: &str, fatwa_sensitive: bool) -> String {
    let mut base = if language == "ar" {
        "لا توجد أدلة موثقة كافية في المكتبة المحلية حالياً. يرجى الرجوع لعالم موثوق.".to_string()
    } else {
        "I could not find enough verified evidence in the local library right now. Please consult a qualified scholar."
            .to_string()
    };
    if fatwa_sensitive {
        if language == "ar" {
            base.push_str(" هذا ليس فتوى، ولا يجوز اعتباره حكماً شرعياً نهائياً.");
        } else {
            base.push_str(" This is not a fatwa and must not be treated as a final ruling.");
        }
    }
    base
}

fn render_evidence_answer(
    hits: &[IslamicSearchHit],
    language: &str,
    fatwa_sensitive: bool,
) -> String {
    let mut lines = Vec::new();
    if language == "ar" {
        lines.push("أدلة موثقة من المكتبة المحلية:".to_string());
    } else {
        lines.push("Verified evidence from the local library:".to_string());
    }
    for hit in hits.iter().take(3) {
        lines.push(format!(
            "- {} ({})",
            truncate_for_answer(&hit.chunk_text, 220),
            hit.citation_label
        ));
    }
    if fatwa_sensitive {
        if language == "ar" {
            lines.push("تنبيه: هذه معلومات استدلالية فقط وليست فتوى ملزمة.".to_string());
        } else {
            lines.push("Notice: this is evidence-only context, not a binding fatwa.".to_string());
        }
    }
    lines.join("\n")
}

fn truncate_for_answer(text: &str, max_len: usize) -> String {
    if text.len() <= max_len {
        return text.to_string();
    }
    let mut out = text.chars().take(max_len).collect::<String>();
    out.push_str("...");
    out
}

pub fn stable_hash(input: &str) -> String {
    use std::hash::{Hash, Hasher};
    let mut hasher = std::collections::hash_map::DefaultHasher::new();
    input.hash(&mut hasher);
    format!("{:016x}", hasher.finish())
}

pub fn sanitize_secret_for_logs(input: &str) -> String {
    input.replace("UMMAH_API_KEY", "[REDACTED_ENV_KEY]")
}

pub fn evidence_path(local_hits: usize, qdrant_hits: usize) -> &'static str {
    if local_hits > 0 {
        "local_db_first"
    } else if qdrant_hits > 0 {
        "qdrant_second"
    } else {
        "fallback"
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct QdrantCollectionPlan {
    pub created_collections: Vec<String>,
    pub all_collections: Vec<String>,
    pub created_at: DateTime<Utc>,
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn detects_arabic_when_arabic_dominates() {
        assert_eq!(detect_language_ar_en("ما حكم الصيام"), "ar");
    }

    #[test]
    fn detects_english_when_latin_dominates() {
        assert_eq!(detect_language_ar_en("What is the ruling on fasting"), "en");
    }

    #[test]
    fn hadith_parser_accepts_expected_shape() {
        let payload =
            r#"{"data":[{"id":"1","text":"sample hadith","chapter":"Faith"}],"next_page":2}"#;
        let parsed = parse_hadith_response(payload).expect("parse");
        assert_eq!(parsed.data.len(), 1);
        assert_eq!(parsed.next_page, Some(2));
    }

    #[test]
    fn no_evidence_fallback_is_safe() {
        let msg = no_evidence_fallback("en", true);
        assert!(msg.contains("not a fatwa"));
    }

    #[test]
    fn ummah_secret_name_is_not_logged_raw() {
        let sanitized = sanitize_secret_for_logs("missing UMMAH_API_KEY in env");
        assert!(!sanitized.contains("UMMAH_API_KEY"));
        assert!(sanitized.contains("REDACTED"));
    }

    #[test]
    fn rate_limiter_waits_after_limit() {
        let mut limiter = HourlyRateLimiter::new(1);
        assert_eq!(limiter.required_wait(), Duration::from_secs(0));
        assert!(limiter.required_wait() > Duration::from_secs(0));
    }

    #[test]
    fn fallback_message_has_no_fake_citation() {
        let msg = no_evidence_fallback("en", false);
        assert!(!msg.to_lowercase().contains("bukhari 1"));
        assert!(!msg.to_lowercase().contains("sahih muslim"));
    }

    #[test]
    fn migration_contains_required_phase20_tables() {
        let migration = include_str!("../../db/20260601_phase20_islamic_knowledge_schema.sql");
        for table in [
            "islamic_sources",
            "islamic_documents",
            "islamic_text_chunks",
            "islamic_api_ingestion_runs",
            "islamic_ingestion_errors",
            "islamic_citations",
            "islamic_question_answers",
            "islamic_answer_citations",
            "islamic_embeddings_queue",
        ] {
            assert!(
                migration.contains(table),
                "missing table in migration: {table}"
            );
        }
        assert!(!migration.to_lowercase().contains("drop table"));
        assert!(!migration.to_lowercase().contains("truncate "));
    }

    #[test]
    fn evidence_path_prefers_local_db_then_qdrant() {
        assert_eq!(evidence_path(2, 4), "local_db_first");
        assert_eq!(evidence_path(0, 2), "qdrant_second");
        assert_eq!(evidence_path(0, 0), "fallback");
    }

    #[test]
    fn qdrant_collection_plan_contains_phase20_sets() {
        assert!(QDRANT_COLLECTIONS.contains(&"sakina_islamic_chunks_ar"));
        assert!(QDRANT_COLLECTIONS.contains(&"sakina_islamic_chunks_en"));
        assert!(QDRANT_COLLECTIONS.contains(&"sakina_hadith_chunks"));
        assert!(QDRANT_COLLECTIONS.contains(&"sakina_fatwa_chunks"));
        assert!(QDRANT_COLLECTIONS.contains(&"sakina_quran_chunks"));
    }
}
