            .map_err(|_| ApiError::service_unavailable("UMMAH_API_KEY not configured"))?;
        Ok(serde_json::json!({
            "configured": true,
            "key_present": !key.trim().is_empty(),
            "prayer_times_mode": "dynamic_metadata_only",
            "bulk_prayer_ingestion": false
        }))
    }
}

