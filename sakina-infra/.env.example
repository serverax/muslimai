# Sakina AI — environment template. Copy to .env and fill with real values.
# DO NOT commit the real .env (it is gitignored). These are placeholders only.

# --- required (backend refuses to start / report ready without these) ---
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-with-at-least-32-characters-long-secret
ENCRYPTION_KEY=change-me-with-at-least-32-characters-encryption-key

# --- service wiring (defaults shown; override as needed) ---
SAKINA_ENV=local
SAKINA_LLM_ENABLED=true
SAKINA_LLM_GATEWAY_URL=http://llm-gateway:8087
OLLAMA_BASE_URL=http://ollama:11434
SAKINA_LLM_MODEL=qwen2.5:0.5b
QDRANT_URL=http://qdrant:6333
SAKINA_REDIS_URL=redis://redis:6379

# --- optional distributed microservice URLs (unset = monolithic mode) ---
# SAKINA_BRAIN_URL=http://brain:8080
# SAKINA_RULES_ENGINE_URL=http://rules-engine:8080
# SAKINA_CITATION_GUARD_URL=http://citation-guard:8080

# --- CORS allowlist (comma-separated origins) ---
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- safety: these MUST stay false/unset in production (fail-closed) ---
ALLOW_DEMO_MODE=false
ALLOW_MOCK_AI=false
ALLOW_MOCK_RAG=false
ALLOW_MOCK_AUTH=false
ALLOW_MOCK_PAYMENTS=false
ALLOW_FAKE_CI_PASS=false
